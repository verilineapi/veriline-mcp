# Required: your API.market subscriber key (https://api.market). Never commit the real value.
VERILINE_API_KEY=

# Optional: marketplace org/base URL. Default is the documented API.market pattern and
# is unconfirmed against the live Veriline listings until those are approved.
# Documented pattern: https://prod.api.market/api/v1/{workspace}/{product}
# VERILINE_API_BASE=https://prod.api.market/api/v1/veriline

# Optional: buyer auth header name. Default x-api-market-key is confirmed in official
# API.market docs (docs.api.market). Override only for a custom gateway.
# VERILINE_AUTH_HEADER=x-api-market-key

# Optional: full per-product base URLs (no trailing slash). Used to point at
# workers.dev origins in live smoke tests, or if a product is mounted at a
# non-default path. When unset, they are derived from VERILINE_API_BASE + slug.
# VERILINE_EMAIL_AUDITOR_BASE=https://prod.api.market/api/v1/veriline/email-deliverability-auditor
# VERILINE_BUSINESS_ID_BASE=https://prod.api.market/api/v1/veriline/business-tax-id-validator
# VERILINE_NPI_BASE=https://prod.api.market/api/v1/veriline/npi-registry-lookup

# Optional: per-product keys (defaults to VERILINE_API_KEY). Useful when hitting
# origins that each have their own X-Gateway-Secret.
# VERILINE_EMAIL_AUDITOR_KEY=
# VERILINE_BUSINESS_ID_KEY=
# VERILINE_NPI_KEY=

# Optional request timeout in milliseconds (default 5000).
# VERILINE_TIMEOUT_MS=5000
